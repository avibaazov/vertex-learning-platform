# Canonical list of environment variables for the Vertex web app and Studio.
# Copy to `.env.local` and fill in. Never commit `.env.local`.

# --- Sanity (shared) ---------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID="f1xc8l6s"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-09-03"

# Server-only viewer token for the private dataset. Create one at
# https://www.sanity.io/manage/project/f1xc8l6s/api  (role: Viewer)
SANITY_API_READ_TOKEN=

# Read by the standalone Studio (studio/). Default to the public values above.
SANITY_STUDIO_PROJECT_ID="f1xc8l6s"
SANITY_STUDIO_DATASET="production"

# --- Clerk -----------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
